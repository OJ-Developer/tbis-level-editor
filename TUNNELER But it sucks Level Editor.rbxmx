					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local HttpService = game:GetService("HttpService")

local plugin: Plugin

local PromptPopups = {}

local DEFAULT_WIDGET_INFO = DockWidgetPluginGuiInfo.new(
    Enum.InitialDockState.Float,
    false,
    false,
    300,
    200,
    300,
    200
)

function PromptPopups.Init(p)
    plugin = p
end

-- TEXT PROMPT
function PromptPopups.PromptForText(messageText: string, widgetTitle: string, inputPlaceholderText: string?): (string, boolean)
    local widget = plugin:CreateDockWidgetPluginGuiAsync(HttpService:GenerateGUID(false), DEFAULT_WIDGET_INFO)

    local ui = script.Parent.Parent.Gui.TextPromptPopup:Clone()
    ui.Parent = widget
    widget.Title = widgetTitle
    widget.Enabled = true
    ui.Message.Text = messageText
    ui.Input.PlaceholderText = inputPlaceholderText

    local entered = false
    local cancelled = false
    local thread1 = task.spawn(function()
        repeat
            entered = ui.Input.FocusLost:Wait()
        until entered
    end)
    local thread2 = task.spawn(function()
        repeat
            local property = widget.Changed:Wait()
            if property == "Enabled" and not widget.Enabled then
                cancelled = true
            end
        until cancelled
    end)

    repeat task.wait() until entered or cancelled

    task.cancel(thread1)
    task.cancel(thread2)

    local result = ui.Input.Text

    widget:Destroy()
    ui:Destroy()

    return result, cancelled
end

-- YES/NO PROMPT
function PromptPopups.PromptYesNo(messageText: string, widgetTitle: string, replacementOptions: {yes: string, no: string}?): (boolean?, boolean)
    local widget = plugin:CreateDockWidgetPluginGuiAsync(HttpService:GenerateGUID(false), DEFAULT_WIDGET_INFO)

    local ui = script.Parent.Parent.Gui.YesNoPromptPopup:Clone()
    ui.Parent = widget
    widget.Title = widgetTitle
    widget.Enabled = true
    ui.Message.Text = messageText

    if replacementOptions then
        ui.Yes.Text = replacementOptions.yes
        ui.No.Text = replacementOptions.no
    end

    local yesSelected = false
    local noSelected = false

    local yesConnection = ui.Yes.MouseButton1Down:Once(function()
        yesSelected = true
    end)
    local noConnection = ui.No.MouseButton1Down:Once(function()
        noSelected = true
    end)
    
    local cancelled = false
    local waitingForCancel = task.spawn(function()
        repeat
            local property = widget.Changed:Wait()
            if property == "Enabled" and not widget.Enabled then
                cancelled = true
            end
        until cancelled
    end)

    repeat task.wait() until yesSelected or noSelected or cancelled

    widget:Destroy()
    ui:Destroy()

    if yesSelected then
        noConnection:Disconnect()
        task.cancel(waitingForCancel)
        return true, false
    elseif noSelected then
        yesConnection:Disconnect()
        task.cancel(waitingForCancel)
        return false, false
    else
        yesConnection:Disconnect()
        noConnection:Disconnect()
        return nil, true
    end
end

function PromptPopups.MessagePopup(message: string, widgetTitle: string)
    local widget = plugin:CreateDockWidgetPluginGuiAsync(HttpService:GenerateGUID(false), DEFAULT_WIDGET_INFO)

    local ui = script.Parent.Parent.Gui.Message:Clone()
    ui.Parent = widget
    widget.Title = widgetTitle
    widget.Enabled = true
    ui.Message.Text = message
    
    task.spawn(function()
        local closed = false
        repeat
            local property = widget.Changed:Wait()
            if property == "Enabled" and not widget.Enabled then
                closed = true
            end
        until closed

        widget:Destroy()
        ui:Destroy()
    end)
end

return PromptPopups]]></ProtectedString>
					<string name="ScriptGuid">{6FDD2C38-9721-4604-AB44-43F17928A2E4}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">PromptPopups</string>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXB1BA1C6B64A84EA4B126C0E4A07D7CA7">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Utils = require(script.Parent.Parent.Utils)

local UiTheming = {}

UiTheming.CustomStyleGuideColour = {
    Red = {
        Dark = Color3.fromRGB(85, 0, 0),
        Light = Color3.fromRGB(255, 85, 85)
    },
    Green = {
        Dark = Color3.fromRGB(0, 85, 0),
        Light = Color3.fromRGB(85, 255, 85)
    }
}

local function getColour(colourName: string, modifierName: string?): Color3?
    if not colourName then return end

    local colourEnum = Enum.StudioStyleGuideColor:FromName(colourName)

    if not colourEnum then
        if UiTheming.CustomStyleGuideColour[colourName] then
            return UiTheming.CustomStyleGuideColour[colourName][settings().Studio.Theme.Name]
        else
            return
        end
    end

    local modifier
    if modifierName then
        modifier = Enum.StudioStyleGuideModifier:FromName(modifierName)
    end

    return settings().Studio.Theme:GetColor(colourEnum, modifier)
end

function UiTheming.UpdateUiColour(UiElement)
    if not UiElement:IsA("GuiObject") then return end

    local colour = getColour(UiElement:GetAttribute("Colour"), UiElement:GetAttribute("Modifier"))
    if colour then
        UiElement.BackgroundColor3 = colour
    end
    
    local borderColour = getColour(UiElement:GetAttribute("BorderColour"))
    if borderColour then
        UiElement.BorderColor3 = borderColour
    end
    
    if Utils.HasProperty(UiElement, "TextColor3") then
        UiElement.TextColor3 = settings().Studio.Theme:GetColor(Enum.StudioStyleGuideColor.MainText)
    end
    if Utils.HasProperty(UiElement, "TextColor3") then
        UiElement.TextColor3 = settings().Studio.Theme:GetColor(Enum.StudioStyleGuideColor.MainText)
    end
end

function UiTheming.UpdateDescendantsUiColours(UiElement: GuiObject)
    UiTheming.UpdateUiColour(UiElement)
    for _, v in UiElement:GetDescendants() do
        UiTheming.UpdateUiColour(v)
    end
end

return UiTheming]]></ProtectedString>
					<string name="ScriptGuid">{7E882F59-9604-41C1-A196-CB420CFFA570}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">UiTheming</string>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXB7EEE24260254ED4B7A6A83DD9AB2E99">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local ChangeHistoryService = game:GetService("ChangeHistoryService")
local Selection = game:GetService("Selection")
local Utils = require(script.Parent.Parent.Utils)

--local plugin

local InsertObjects = {}

local insertableObjects = script.Parent.Parent.InsertableObjects
local gui: typeof(script.Parent.Parent.Gui.InsertObjects)
local selectedCategory: string?

function InsertObjects.Init(p, ui)
    --plugin = p

    gui = ui

    for _, category: Instance in gui.Categories:GetChildren() do
        if category:IsA("TextButton") then
            category.MouseButton1Down:Connect(function()
                ChangeCategory(category.Name)
            end)
        end
    end
end

function ChangeCategory(newCategory: string)
    selectedCategory = newCategory
    InsertObjects.RefreshList()
end

function InsertObjects.RefreshList()
    -- clear anything already in the list
    for _, button in gui.List:GetChildren() do
        if button:IsA("TextButton") then
            button:Destroy()
        end
    end

    if not selectedCategory then return end
    if not insertableObjects:FindFirstChild(selectedCategory) then return end

    -- refresh list
    local objectsToShow: {BasePart | Model} = insertableObjects[selectedCategory]:GetChildren()
    for _, object in objectsToShow do
        local newButton = gui.TemplateInsertableObjectButton:Clone()
        newButton.Name = object.Name
        newButton.Text = object.Name
        newButton.Parent = gui.List
        newButton.Visible = true
        newButton.MouseButton1Down:Connect(function()
            InsertObjects.InsertObject(object)
        end)
    end
end

function InsertObjects.InsertObject(object: BasePart | Model)
    if not object.Parent then return end -- this is needed to make the dumb bullshit error warning thing go away
    if not workspace.EditingLevel:GetAttribute("Level") then
        warn("Can't add new object. No level is loaded.")
        return
    end

    ChangeHistoryService:SetWaypoint("InsertObject")

    -- create new object and parent it to the correct place
    local newObject = object:Clone()
    local parent = object:GetAttribute("Parent")
    if parent then
        newObject.Parent = workspace.EditingLevel:FindFirstChild(parent)
    else
        newObject.Parent = workspace.EditingLevel:FindFirstChild(object.Parent.Name)
    end

    -- position object
    if newObject:IsA("BasePart") then
        newObject.Position = workspace.CurrentCamera.CFrame.Position

        local target = workspace.CurrentCamera.CFrame.lookVector * 20
        local shapecast = workspace:Shapecast(newObject, target)
        if shapecast then
            newObject.Position = workspace.CurrentCamera.CFrame.Position + workspace.CurrentCamera.CFrame.lookVector * shapecast.Distance
        else
            newObject.Position = target + workspace.CurrentCamera.CFrame.Position
        end

        newObject.Position = Utils.roundVector(newObject.Position)
    elseif newObject:IsA("Model") then
        newObject:PivotTo(CFrame.new(workspace.CurrentCamera.CFrame.Position))

        local cframe, size = newObject:GetBoundingBox()
        local boundingBox = Instance.new("Part")
        boundingBox.Anchored = true
        boundingBox.Parent = workspace
        boundingBox.CFrame = cframe
        boundingBox.Size = size
        boundingBox.Position = workspace.CurrentCamera.CFrame.Position

        local target = workspace.CurrentCamera.CFrame.lookVector * 20
        local shapecast = workspace:Shapecast(boundingBox, target)
        if shapecast then
            newObject:PivotTo(CFrame.new(workspace.CurrentCamera.CFrame.Position + workspace.CurrentCamera.CFrame.lookVector * shapecast.Distance))
        else
            newObject:PivotTo(CFrame.new(target + workspace.CurrentCamera.CFrame.Position))
        end

        boundingBox:Destroy()

        newObject:PivotTo(CFrame.new(Utils.roundVector(newObject.WorldPivot.Position)) * newObject.WorldPivot.Rotation)
    end
    
    -- select the object
    Selection:Set({newObject})

    ChangeHistoryService:SetWaypoint("InsertObject")
end

return InsertObjects]]></ProtectedString>
					<string name="ScriptGuid">{9D7EE7F5-5C9E-4980-BD30-8900FBEB662D}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
